{
  "basic": {
    "type": "object",
    "title": "基础",
    "description": "随机颜文字：同款连用就换",
    "items": {
      "faces_enabled": {
        "description": "启用插件",
        "hint": "关掉后回复里的颜文字原样保留，不做任何替换",
        "type": "bool",
        "default": true
      },
      "faces_repeat_window": {
        "description": "连用窗口（条）",
        "hint": "同一张脸在该会话最近 N 条消息里出现过就换一张同情绪的（默认 2：上上条用过也算重复）。填 0 = 每张都随机发牌（彻底由库决定用哪张）",
        "type": "int",
        "default": 2,
        "optional": false
      },
      "faces_hot_max": {
        "description": "单脸上限（次）",
        "hint": "最近统计条数内同一张脸出现≥这个次数就强制换（默认 3，0=关）——治\"百搭脸隔条复读\"：连用窗口只拦得住紧挨着的重复，拦不住每隔一条用一次的刷屏脸",
        "type": "int",
        "default": 3,
        "optional": false
      },
      "faces_hot_window": {
        "description": "单脸上限·统计条数",
        "hint": "单脸上限在最近多少条消息里数（默认 20）",
        "type": "int",
        "default": 20,
        "optional": false
      },
      "faces_prompt_on": {
        "description": "风格注入（教上游）",
        "hint": "把选脸/拟声词的规则注进每次 LLM 请求的 system_prompt——模型照规则从情绪池里换着挑脸、拟声词换着用，跟人设解耦（改池改文案不用动人设）。关掉则只保留下游换脸",
        "type": "bool",
        "default": true
      },
      "faces_prompt_hint": {
        "description": "注入文案",
        "hint": "{pools} 占位符=当前装载的池名列表（不写就不带池名）；清空=恢复默认。想加自家风格规矩（语气、称呼、特殊场景的用法）直接写在这段里，每次请求都会带上",
        "type": "text",
        "default": "颜文字按当下情绪从这些类别里换着挑一张（{pools}）——同一个别连着用、别固定一张；拟声词也换着用（唔、嗯、呀、哈…按当下感觉来），放开头或单独成小句，别嵌进句子中间"
      },
      "faces_blacklist": {
        "description": "必换黑名单",
