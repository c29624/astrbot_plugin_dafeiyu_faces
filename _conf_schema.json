  "basic": {
    "type": "object",
    "title": "基础",
    "description": "随机颜文字：同款连用就换",
    "items": {
      "faces_enabled": {
        "description": "启用插件",
        "hint": "关掉后回复里的颜文字原样保留，不做任何替换",
        "type": "bool",
        "default": true
      },
      "faces_repeat_window": {
        "description": "连用窗口（条）",
        "hint": "同一张脸在该会话最近 N 条消息里出现过就换一张同情绪的（默认 2：上上条用过也算重复）。填 0 = 每张都随机发牌（彻底由库决定用哪张）",
        "type": "int",
        "default": 2,
        "optional": false
      },
      "faces_hot_max": {
        "description": "单脸上限（次）",
